   OR email IS NULL
   OR price IS NULL
   OR timestamp IS NULL;

SELECT purchase_id, COUNT(*)
FROM production_clean
GROUP BY purchase_id
HAVING COUNT(*) > 1;

SELECT *
FROM production_clean
WHERE price <= 0;


SELECT *
FROM production_clean
WHERE datetime(timestamp) IS NULL;

SELECT 
  (SELECT COUNT(*) FROM staging_raw) AS staging_count,
  (SELECT COUNT(*) FROM cleaned_purchases) AS cleaned_count,
  (SELECT COUNT(*) FROM production_purchases) AS production_count;

